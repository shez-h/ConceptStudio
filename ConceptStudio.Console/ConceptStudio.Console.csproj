<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ConceptStudio.Core/ConceptStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ConceptStudio.GuidelinesMcp/ConceptStudio.GuidelinesMcp.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Build the separate server and place its runnable output beside this app. -->
  <Target Name="CopyGuidelinesMcpServer" AfterTargets="Build">
    <ItemGroup>
      <McpServerFiles Include="../ConceptStudio.GuidelinesMcp/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(McpServerFiles)"
          DestinationFiles="@(McpServerFiles->'$(OutDir)mcp-server/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
